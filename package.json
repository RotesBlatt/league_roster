{
  "name": "lol-team",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "cd apps/web && bun run build",
    "start": "bun run apps/api/src/index.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun run apps/api/src/db/migrate.ts",
    "db:studio": "bunx drizzle-kit studio",
    "check": "biome check --write .",
    "test": "bun test packages/shared/test apps/web/test apps/api/test/unit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.3.10",
    "drizzle-kit": "^0.31.11",
    "postgres": "^4.1.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.10",
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
