{
  "name": "lol-team",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "hooks:install": "bun run scripts/install-hooks.ts",
    "prepare": "bun run scripts/install-hooks.ts",
    "build": "cd apps/web && bun run build",
    "start": "bun run apps/api/src/index.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun run apps/api/src/db/migrate.ts",
    "db:studio": "bunx drizzle-kit studio",
    "check": "biome check --write .",
    "riot:types": "bun --cwd tools/riot-types run generate",
    "test": "bun test packages/shared/test apps/api/test/unit && bun run test:web",
    "test:db": "bun run scripts/test-db.ts",
    "test:all": "bun run test && bun run test:db",
    "test:web": "cd apps/web && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.3.10",
    "drizzle-kit": "^0.31.11",
    "postgres": "^4.1.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.5",
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
