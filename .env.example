# Copy to .env and fill in. Bun loads .env automatically for `bun run dev`.
# docker compose also reads this file (POSTGRES_* are used by the db service).

# --- database ---------------------------------------------------------------
# Used by docker compose: spins up postgres:17 with a named volume `pg-data`.
POSTGRES_USER=lol
POSTGRES_PASSWORD=change-me-url-safe
POSTGRES_DB=lol
# host port for local dev (bound to 127.0.0.1 only)
POSTGRES_PORT=5432

# --- backups (compose `backup` service) -------------------------------------
# one dump every N hours, dumped files older than KEEP days are deleted
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=7

# Connection string for the API. Compose overrides this with host `db`;
# for `bun run dev` this must point at the published localhost port.
DATABASE_URL=postgres://lol:change-me-url-safe@localhost:5432/lol

# --- public origin (docker compose) -----------------------------------------
# The URL you open in the browser for the containerized app. Drives the OAuth
# redirect_uri and cookie flags, so it must be exact.
#   local container test : http://localhost:3001
#   production           : https://lol.example.com
PUBLIC_URL=http://localhost:3001

# --- server (bun run dev) ---------------------------------------------------
PORT=3001
# Public origin of the Vite dev server. Must match the URL you open in the browser.
# Dev: http://localhost:5173   Prod: https://lol.yourdomain.com
BETTER_AUTH_URL=http://localhost:5173
# Same as BETTER_AUTH_URL (kept separate so the API can be put behind a proxy)
WEB_ORIGIN=http://localhost:5173

# --- logging ----------------------------------------------------------------
# debug | info | warn | error. Anything else falls back to info.
LOG_LEVEL=info
# false = console only (in containers you may prefer the json-file driver)
LOG_TO_FILE=true
# relative paths resolve against the repo root
LOG_DIR=logs
# daily api-YYYY-MM-DD.log files older than this are deleted
LOG_RETENTION_DAYS=14
# served /assets/* is debug-level unless true
LOG_ASSETS=false
# requests slower than this are flagged slow:true
LOG_SLOW_MS=500

# --- better-auth ------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- discord oauth ----------------------------------------------------------
# https://discord.com/developers/applications -> New Application -> OAuth2
# Redirect URI to add: <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- riot api ---------------------------------------------------------------
# https://developer.riotgames.com -> your application -> Development key.
# A development key expires every 24 hours and allows ~100 requests per 2 minutes,
# shared by everyone using it. Without a key the app still works: accounts stay
# "unverified" until a lookup succeeds.
RIOT_API_KEY=

# --- champion & patch data (Hexserve) ---------------------------------------
# The team's own per-patch dump: champion names, icons and the current patch.
# Optional — the default is production. Override it to point at a mirror or a
# local copy. A blank value falls back to the default; it is not an error.
# HEXSERVE_BASE_URL=https://hexserve.dump-collector.de

# --- web dev server ---------------------------------------------------------
# Where vite proxies /api during `bun dev`
API_PROXY_TARGET=http://localhost:3001
